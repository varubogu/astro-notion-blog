{
  "name": "astro-notion-blog",
  "type": "module",
  "version": "0.12.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "astro build",
    "build:cached": "bun run cache:fetch && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src",
    "format": "bun x prettier --write .",
    "cache:fetch": "bun scripts/blog-contents-cache.cjs",
    "cache:purge": "nx reset && rm -f tmp/*",
    "_fetch-notion-blocks": "bun scripts/retrieve-block-children.cjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^10.0.1",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/octicon": "^1.2.37",
    "@iconify/icons-logos": "^1.2.36",
    "@notionhq/client": "^5.27.0",
    "@nrwl/nx-cloud": "^19.1.3",
    "@supercharge/promise-pool": "^3.3.0",
    "@types/async-retry": "^1.4.9",
    "@types/bun": "^1.4.2",
    "@types/js-base64": "^3.3.1",
    "@types/katex": "^0.16.8",
    "@types/metascraper": "^5.14.3",
    "@types/metascraper-description": "^5.14.5",
    "@types/metascraper-image": "^5.14.5",
    "@types/metascraper-title": "^5.14.5",
    "@types/prismjs": "^1.26.6",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript-eslint/typescript-estree": "^8.71.1",
    "astro": "^7.3.6",
    "astro-eslint-parser": "^3.2.0",
    "astro-icon": "^1.2.0",
    "async-retry": "^1.3.3",
    "cli-progress": "^3.12.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "exif-be-gone": "^1.5.1",
    "globals": "^17.13.0",
    "katex": "^0.19.0",
    "mermaid": "^12.1.0",
    "metascraper": "^5.58.1",
    "metascraper-description": "^5.56.2",
    "metascraper-image": "^5.56.2",
    "metascraper-title": "^5.56.2",
    "nx": "^23.2.1",
    "prismjs": "^1.30.0",
    "sharp": "^0.35.5",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.71.1"
  },
  "nx": {
    "targets": {
      "_fetch-notion-blocks": {
        "inputs": [
          "!{projectRoot}/**/*",
          "!{projectRoot}/**/.*",
          "!{projectRoot}/**/.*/**/*",
          {
            "env": "DATABASE_ID"
          }
        ],
        "outputs": [
          "{projectRoot}/tmp"
        ]
      }
    },
    "includedScripts": [
      "_fetch-notion-blocks"
    ]
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.64.0"
  }
}
